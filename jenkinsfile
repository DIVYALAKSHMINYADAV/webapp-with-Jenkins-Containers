pipeline {
    agent any

    stages {

        stage('Clone Code') {
            steps {
                git 'https://github.com/DIVYALAKSHMINYADAV/webapp-with-Jenkins-Containers.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t spring:v1 .'
            }
        }

        stage('Check Docker Images') {
            steps {
                sh 'docker images'
            }
        }

        stage('Run Docker Container') {
            steps {
                sh 'docker rm -f spring-container || true'
                sh 'docker run -d -p 8181:9090 --name spring-container spring:v1'
            }
        }

        stage('Check Running Containers') {
            steps {
                sh 'docker ps'
            }
        }
    }

    post {
        success {
            echo 'Application deployed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
